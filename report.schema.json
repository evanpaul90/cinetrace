{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinetrace.dev/schemas/report-2.0.0.json",
  "title": "CineTrace audit report",
  "type": "object",
  "required": ["schemaVersion", "tool", "environment", "target", "generatedAt", "configuration", "controls", "verdict", "defects", "viewports"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "CineTrace" },
        "version": { "type": "string" }
      }
    },
    "target": { "type": "string", "format": "uri" },
    "environment": {
      "type": "object",
      "required": ["browser", "os", "runtime", "renderer", "metricLabels"],
      "properties": {
        "browser": {
          "type": "object",
          "required": ["engine", "version"],
          "properties": { "engine": { "enum": ["chromium", "firefox", "webkit"] }, "version": { "type": "string" } }
        },
        "os": {
          "type": "object",
          "required": ["platform", "arch", "release"],
          "properties": { "platform": { "type": "string" }, "arch": { "type": "string" }, "release": { "type": "string" } }
        },
        "runtime": {
          "type": "object",
          "required": ["name", "version"],
          "properties": { "name": { "const": "node" }, "version": { "type": "string" } }
        },
        "renderer": {
          "type": "object",
          "required": ["metricScope", "available", "api", "vendor", "renderer", "unmaskedVendor", "unmaskedRenderer"],
          "properties": {
            "metricScope": { "const": "webgl-specific" },
            "available": { "type": ["boolean", "null"] },
            "api": { "type": ["string", "null"] },
            "vendor": { "type": ["string", "null"] },
            "renderer": { "type": ["string", "null"] },
            "unmaskedVendor": { "type": ["string", "null"] },
            "unmaskedRenderer": { "type": ["string", "null"] }
          }
        },
        "metricLabels": { "type": "object" }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "configuration": {
      "type": "object",
      "required": ["viewports", "steps", "direction", "adapter", "selectors", "forceWebglFailure", "checkReducedMotion", "controlRuns", "browser"],
      "properties": {
        "viewports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/viewport" } },
        "steps": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "direction": { "enum": ["forward", "reverse", "both"] },
        "adapter": { "type": "string" },
        "selectors": {
          "type": "object",
          "required": ["primaryAction", "noJsPrimaryAction", "semanticContent", "noJsSemanticContent", "overlay", "overlayTarget"],
          "additionalProperties": false,
          "properties": {
            "primaryAction": { "type": "string", "minLength": 1 },
            "noJsPrimaryAction": { "type": "string", "minLength": 1 },
            "semanticContent": { "type": "string", "minLength": 1 },
            "noJsSemanticContent": { "type": "string", "minLength": 1 },
            "overlay": { "type": "string", "minLength": 1 },
            "overlayTarget": { "type": "string", "minLength": 1 }
          }
        },
        "forceWebglFailure": { "type": "boolean" }
        ,"checkReducedMotion": { "type": "boolean" }
        ,"controlRuns": { "type": "integer", "minimum": 1, "maximum": 5 }
        ,"browser": { "enum": ["chromium", "firefox", "webkit"] }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["pass", "defectCount"],
      "properties": {
        "pass": { "type": "boolean" },
        "defectCount": { "type": "integer", "minimum": 0 }
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "viewport", "severity"],
        "properties": {
          "code": { "type": "string" },
          "viewport": { "type": "string" },
          "severity": { "enum": ["error", "warning"] }
        }
      }
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["viewport", "frames", "checks"],
        "properties": {
          "viewport": { "$ref": "#/$defs/viewport" },
          "frames": { "type": "array" },
          "checks": {
            "type": "object",
            "required": ["overflow", "semantics", "primaryAction", "primaryActionFallback", "keyboardReachability", "overlayCollision", "semanticFallback", "reverseDrift", "reducedMotion", "webglFailure", "pageErrors"],
            "properties": {
              "overflow": { "$ref": "#/$defs/check" },
              "semantics": { "$ref": "#/$defs/check" },
              "primaryAction": { "$ref": "#/$defs/check" },
              "primaryActionFallback": { "$ref": "#/$defs/check" },
              "keyboardReachability": { "$ref": "#/$defs/check" },
              "overlayCollision": { "type": "object" },
              "semanticFallback": { "$ref": "#/$defs/check" },
              "reverseDrift": { "type": "object" },
              "reducedMotion": { "$ref": "#/$defs/check" },
              "webglFailure": { "type": "object" },
              "pageErrors": { "$ref": "#/$defs/check" }
            }
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "required": ["checked", "requestedRuns", "completedRuns", "pass", "baselineFingerprint", "runs"],
      "properties": {
        "checked": { "type": "boolean" },
        "requestedRuns": { "type": "integer", "minimum": 1 },
        "completedRuns": { "type": "integer", "minimum": 1 },
        "pass": { "type": ["boolean", "null"] },
        "baselineFingerprint": { "type": "string" },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["run", "fingerprint", "match", "sameBuild", "report"],
            "properties": {
              "run": { "type": "integer", "minimum": 1 },
              "fingerprint": { "type": "string" },
              "match": { "type": "boolean" },
              "sameBuild": { "type": "boolean" },
              "report": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["pass"],
      "properties": { "pass": { "type": ["boolean", "null"] } }
    },
    "viewport": {
      "type": "object",
      "required": ["name", "width", "height", "deviceScaleFactor"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 200 },
        "height": { "type": "integer", "minimum": 200 },
        "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 }
      }
    }
  }
}
