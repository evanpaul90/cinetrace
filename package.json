{
  "name": "cinetrace",
  "version": "0.3.0",
  "description": "Deterministic filmstrip audits for scroll- and progress-driven web experiences.",
  "keywords": [
    "playwright",
    "webgl",
    "scroll-animation",
    "visual-regression",
    "reduced-motion",
    "progressive-enhancement",
    "browser-testing",
    "web-animation",
    "cli"
  ],
  "author": "Evan D'Souza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evanpaul90/cinetrace.git"
  },
  "homepage": "https://evanpaul90.github.io/cinetrace/",
  "bugs": {
    "url": "https://github.com/evanpaul90/cinetrace/issues"
  },
  "type": "module",
  "bin": {
    "cinetrace": "./src/cli.js"
  },
  "exports": {
    ".": "./index.js",
    "./default-adapter": "./src/default-adapter.js",
    "./report.schema.json": "./report.schema.json"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "src/",
    "report.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "audit": "node ./src/cli.js audit",
    "test": "node --test ./test/*.test.js",
    "evidence:verify": "node ./scripts/verify-evidence.mjs"
  },
  "dependencies": {
    "playwright": "^1.58.2"
  },
  "license": "MIT",
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
